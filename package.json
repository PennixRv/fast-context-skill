{
  "name": "@pennixrv/fast-context-skill",
  "version": "0.1.0",
  "description": "Agent Skill and CLI adaptation of fast-context-mcp that runs Windsurf Devstral semantic code search without an MCP server.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "fast-context-skill": "scripts/fast-context-search.mjs"
  },
  "files": [
    "SKILL.md",
    "README.md",
    "NOTICE.md",
    "LICENSE",
    "references/script-contract.md",
    "agents/openai.yaml",
    "scripts/fast-context-search.mjs",
    "scripts/lib/LICENSE.fast-context-mcp",
    "scripts/lib/core.mjs",
    "scripts/lib/executor.mjs",
    "scripts/lib/path-guard.mjs",
    "scripts/lib/protobuf.mjs",
    "scripts/lib/public-error.mjs"
  ],
  "scripts": {
    "search": "node scripts/fast-context-search.mjs",
    "test": "node --test test/*.test.mjs",
    "verify:provenance": "node scripts/release/verify-provenance.mjs",
    "pack:check": "node test/package-content.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pennixrv/fast-context-skill.git"
  },
  "bugs": {
    "url": "https://github.com/pennixrv/fast-context-skill/issues"
  },
  "homepage": "https://github.com/pennixrv/fast-context-skill#readme",
  "keywords": [
    "agent-skill",
    "skills-cli",
    "codex",
    "skill",
    "fast-context",
    "semantic-search",
    "windsurf",
    "devstral",
    "code-search"
  ],
  "engines": {
